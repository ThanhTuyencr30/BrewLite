PORT=3001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://brewlite:change_this_local_password@localhost:5432/brewlite?schema=public
JWT_SECRET=replace_with_a_long_random_secret

# VNPay sandbox (đăng ký tại https://sandbox.vnpayment.vn/devreg/ để nhận mã).
# Điền giá trị thật vào .env, KHÔNG commit khóa thật.
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPay đưa trình duyệt của khách về địa chỉ này sau khi thanh toán.
VNPAY_RETURN_URL=http://localhost:3001/payments/vnpay/return
